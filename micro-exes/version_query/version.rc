#include <winver.h>

/* The RT_VERSION resource the version_query micro reads back. File version
 * 1.2.3.4, product 5.6.7.8, one en-US (0x0409) translation on codepage
 * 1200 (0x04B0) — values the micro asserts against. */
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,2,3,4
 PRODUCTVERSION 5,6,7,8
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "WIE Test\0"
            VALUE "FileDescription", "version query micro\0"
            VALUE "FileVersion", "1.2.3.4\0"
            VALUE "ProductVersion", "5.6.7.8\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
