// Modal-dialog RT_DIALOG fixture for gui_blit.exe (the "About" dialog).
// Compile: x86_64-w64-mingw32-windres gui_blit/dialog.rc -o out/gui_blit_res.o
// Uses plain DIALOG (not DIALOGEX) — windres emits the standard DLGTEMPLATE.
// Template id 100; two push buttons (IDOK=1, IDCANCEL=2) + one LTEXT (1001).

100 DIALOG 10, 20, 160, 60
STYLE 0x00000040 | 0x80000000 | 0x00C00000
CAPTION "About WIE Blit"
FONT 8, "MS Shell Dlg"
BEGIN
    PUSHBUTTON "OK", 1, 10, 10, 60, 20
    PUSHBUTTON "Cancel", 2, 80, 10, 60, 20
    LTEXT "About WIE Blit", 1001, 10, 36, 120, 10
END
